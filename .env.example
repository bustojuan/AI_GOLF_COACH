# Optional development proxy target (frontend/vite.config.ts)
AIGOLF_BACKEND_URL=http://127.0.0.1:8000

# AI generation is opt-in. No external service is needed for video analysis,
# comparison, scoring, or the local report preview.
GOLF_COACH_AI_ENABLED=false
GOLF_COACH_AI_PROVIDER=disabled
GOLF_COACH_AI_MODEL=
GOLF_COACH_AI_API_KEY=
